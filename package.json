{
  "name": "@spicrawl/mcp",
  "version": "0.1.8",
  "mcpName": "io.github.OfficialSpicrawl/mcp",
  "description": "MCP server for web scraping: scrape any URL to Markdown or JSON for Claude, Cursor and AI agents, with JavaScript rendering, crawling and data extraction",
  "license": "Apache-2.0",
  "author": "Spicrawl",
  "homepage": "https://docs.spicrawl.com/agents/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OfficialSpicrawl/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/OfficialSpicrawl/mcp/issues"
  },
  "keywords": [
    "spicrawl",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "web-scraping",
    "web-scraper",
    "scraper",
    "crawler",
    "markdown",
    "html-to-markdown",
    "data-extraction",
    "structured-data",
    "javascript-rendering",
    "browser-automation",
    "llm",
    "rag",
    "ai-agents",
    "claude",
    "claude-code",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "spicrawl-mcp": "dist/index.js",
    "spicrawl-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test",
    "registry:validate": "node scripts/registry.mjs validate",
    "registry:sync": "node scripts/registry.mjs sync",
    "version": "npm run registry:sync"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "^5.7.3"
  }
}
